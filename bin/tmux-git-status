#!/usr/bin/env bash
# Status-bar segment for the pane's cwd: branch, ahead/behind, dirty, worktrees, remote, open tasks.
cd "${1:-$PWD}" 2>/dev/null || exit 0
# Outside a repo with exactly one repo directly below (e.g. a workspace dir), report that repo.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  repos=$(find . -mindepth 2 -maxdepth 2 -name .git 2>/dev/null)
  [ -n "$repos" ] && [ "$(wc -l <<<"$repos")" -eq 1 ] && cd "$(dirname "$repos")"
fi
out=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  st=$(git status --porcelain=v2 --branch 2>/dev/null)
  branch=$(sed -n 's/^# branch.head //p' <<<"$st")
  upstream=$(sed -n 's/^# branch.upstream //p' <<<"$st")
  read -r ahead behind < <(sed -n 's/^# branch.ab +\([0-9]*\) -\([0-9]*\)/\1 \2/p' <<<"$st")
  staged=$(grep -c '^[12] [MADRC]' <<<"$st")
  changed=$(grep -c '^[12] .[MADRC]' <<<"$st")
  untracked=$(grep -c '^?' <<<"$st")
  wts=$(git worktree list 2>/dev/null | wc -l | tr -d ' ')
  out="#[fg=#7aa2f7] ${branch}"
  [ -n "$upstream" ] && out+="#[fg=#565f89]→${upstream%%/*}"
  [ "${ahead:-0}" != 0 ] && out+=" #[fg=#9ece6a]↑${ahead}"
  [ "${behind:-0}" != 0 ] && out+=" #[fg=#f7768e]↓${behind}"
  [ "$staged" != 0 ] && out+=" #[fg=#9ece6a]+${staged}"
  [ "$changed" != 0 ] && out+=" #[fg=#e0af68]~${changed}"
  [ "$untracked" != 0 ] && out+=" #[fg=#565f89]?${untracked}"
  [ "$wts" -gt 1 ] && out+=" #[fg=#bb9af7]wt:${wts}"
fi
if command -v tt >/dev/null; then
  n=$(tt count 2>/dev/null)
  [ -n "$n" ] && [ "$n" != 0 ] && out+=" #[fg=#565f89]│ #[fg=#e0af68] ${n}"
fi
printf '%s' "$out"
